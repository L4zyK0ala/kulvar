# Zorunlu: kimlik bilgilerini veritabanında şifrelemek için Fernet anahtarı. Üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KULVAR_ENCRYPTION_KEY=

KULVAR_DATABASE_URL=sqlite:///kulvar.db
KULVAR_HOST=127.0.0.1
KULVAR_PORT=8010
KULVAR_SYNC_INTERVAL_MINUTES=45
KULVAR_SYNC_LOOKBACK_DAYS=14
KULVAR_TIMEZONE=Europe/Istanbul
# Docker'da konteynerin yerel saati (paneldeki "bugün", akşam kontrolü)
TZ=Europe/Istanbul
# Tarayıcının uygulamaya ulaştığı adres (Strava OAuth dönüşü için), örn. https://kulvar.internal
KULVAR_PUBLIC_URL=http://localhost:8010

# Strava: strava.com/settings/api → "API Application". Yeni uygulamalar 1 sporcuyla sınırlı;
# ikinci profil kendi Strava uygulamasını Ayarlar sayfasından girebilir.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SILENCE_TOKEN_WARNINGS=true

# İsteğe bağlı: Claude koç sohbeti (console.anthropic.com). Boşsa koç sekmesi kapalı kalır.
ANTHROPIC_API_KEY=
KULVAR_COACH_MODEL=claude-opus-5-5
KULVAR_COACH_EFFORT=medium
KULVAR_COACH_MONTHLY_BUDGET_USD=10

# İsteğe bağlı: tüm profiller için ortak Telegram botu (profil başına bot Ayarlar'dan da eklenebilir)
TELEGRAM_BOT_TOKEN=
KULVAR_EVENING_CHECK_HOUR=21
